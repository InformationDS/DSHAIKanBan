# Keep every pnpm write inside the workspace: the DSH file sandbox grants
# `workspace-write` here and nothing outside, so a store/cache under the user
# profile would need one escalation per install. `nodeLinker: hoisted` is set
# in pnpm-workspace.yaml because a hard-link-only local store cannot junctions
# against the global store.
store-dir=.pnpm-store
cache-dir=.pnpm-cache
state-dir=.pnpm-state
