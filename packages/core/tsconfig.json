{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    // Every source file is also executed directly by Node's type stripping
    // (vitest / node --test), so only erasable syntax is allowed here.
    "erasableSyntaxOnly": true,
    // Sources import './x.ts' so Node can run them unbuilt; the emit rewrites
    // those specifiers to './x.js'.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
