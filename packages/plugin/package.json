{
  "name": "@aikanban/dsh-aikanban",
  "version": "0.0.0",
  "private": true,
  "description": "AIKanBan — turn DSH conversations into durable project/task records on a kanban board. Dual-half DSH plugin: a host half (cordis plugin, `lib/index.js`) and a browser half (`lib/client.js`, a `window.__ModuleLoader__.load` bundle) that mounts the board on the `main` slot plus a `sidebar.panellist` icon.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && tsdown -c tsdown.config.ts && tsdown -c tsdown.client.config.ts",
    "build:bundle": "tsdown -c tsdown.config.ts && tsdown -c tsdown.client.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aikanban/core": "workspace:*",
    "@aikanban/plugin-client": "workspace:*"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
